{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080 {
			# IP real de quem acessa, para o limite de login. Só o túnel alcança o Caddy.
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}

	handle /health {
		reverse_proxy backend:8080
	}

	# Arquivos com hash do build: guardados por um ano. Sem try_files, o que não existe dá 404.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: o navegador confere o index.html a cada acesso (ETag).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Erros (ex.: 404 de /assets/*) não ficam no cache.
	handle_errors {
		header Cache-Control "no-store"
	}
}
