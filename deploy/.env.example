# Copie para deploy/.env e ajuste os valores.

POSTGRES_DB=xet
POSTGRES_USER=xet
# Use apenas letras e números na senha: ela entra na URL de conexão do backend.
POSTGRES_PASSWORD=troque-esta-senha

LOG_LEVEL=info

# Endereço do site. ":80" serve HTTP sem certificado; um domínio (ex.: atendimento.exemplo.com.br) ativa HTTPS automático.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
