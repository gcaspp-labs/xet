# Copie para deploy/.env e ajuste os valores.

POSTGRES_DB=xet
POSTGRES_USER=xet
# Use apenas letras e números na senha: ela entra na URL de conexão do backend.
POSTGRES_PASSWORD=troque-esta-senha

LOG_LEVEL=info

# Token do túnel, copiado do painel da Cloudflare. Sem ele, o make up não sobe. Nunca coloque o valor no repositório.
CLOUDFLARE_TUNNEL_TOKEN=

# O HTTPS termina na Cloudflare: o Caddy recebe HTTP do túnel, na rede interna do Compose.
SITE_ADDRESS=:80
# O navegador fala HTTPS, então o cookie de sessão continua Secure.
COOKIE_SECURE=true
